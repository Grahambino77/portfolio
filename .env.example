# ============================================================
# .env.example — Copy this to .env and fill in your values.
# DO NOT put real credentials in this file.
# ============================================================

SECRET_KEY=change-me-to-a-long-random-string

# ── Resend (replaces Gmail SMTP — works on Render free tier) ─────────────────
# Sign up free at https://resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email address that receives contact form submissions (your Gmail)
NOTIFY_EMAIL=you@gmail.com

# Optional: verified sender address.  Leave blank to use Resend's default
# (onboarding@resend.dev).  To use a custom address, verify your domain at
# https://resend.com/domains and set e.g.: "Portfolio <you@yourdomain.com>"
RESEND_FROM=Portfolio Contact <onboarding@resend.dev>
